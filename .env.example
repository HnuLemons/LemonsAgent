# 大模型基本配置信息
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_BASE_URL=your_base_url_here
ANTHROPIC_MODEL=your_model_key_here

AGENT_MEMORY_COMPACT_AFTER=18 # 可选：记忆压缩阈值（历史消息超过该条数时触发压缩）
AGENT_MAX_TURNS=20 #最 大对话轮次
AGENT_CONTEXT_MAX_MESSAGES=40 # 上下文中最多保留的消息条数
AGENT_TOOL_RESULT_MAX_CHARS=3000 # 单条工具调用结果最多字符数

# Tavily 搜索 API Key（到 https://app.tavily.com 注册免费获取，每月1000次免费额度）
TAVILY_API_KEY=your_tavily_api_key_here
